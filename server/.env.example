# 服务端口
PORT=3000

# MySQL 连接（Prisma）
DATABASE_URL="mysql://root:your_password@127.0.0.1:3306/feishu_work"

# 飞书应用（开发者后台 → 凭证与基础信息）
# 注意：真实 AppID/AppSecret 只填到本地 .env（已 gitignore），勿提交到仓库
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxx
# 网页授权回调（仅浏览器直接访问时用）
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback
# 审批定义编码（飞书审批后台创建）
FEISHU_APPROVAL_CODE=报工审批

# 事件订阅（审批回调）校验
FEISHU_EVENT_VERIFY_TOKEN=your_verify_token
FEISHU_EVENT_ENCRYPT_KEY=

# 本系统 JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 工作日免审批额度（小时）
WORKING_HOURS_LIMIT=8
